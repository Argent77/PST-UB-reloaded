// 戴娜拉对话
@0 = ~“此地会压制所有非本位面的能量。若你依靠附魔或法术来保护自己，必将陨落。”她用更为急切的语气继续说道。“寻找你上次造访此地时留下的线索。”~

// 福尔对话
@50 = ~“关于巴托地狱，还有什么我需要了解的吗？”~
@51 = ~“那个地方的魔法*可能*会受到干扰。但像你这样……有分量的人，应该能毫发无损地穿越那片平原。”~
@52 = ~“能再详细解释一下吗？”~
@53 = ~“你非要问？哼！外层位面对于你这样的人来说，可能距离魔法的源头太远了，除非……”~
@54 = ~“除非什么？”~
@55 = ~“除非你手头有一个‘钥匙’来聚焦魔法能量。”~
@56 = ~“你有这样的钥匙吗？”~
@57 = ~“呃？有，这东西可能就丢在这附近的什么地方。”~
@58 = ~“请把它给我！”~
@59 = ~“哼！给你。*还有*什么我能效劳的？”~
@60 = ~“哼！当然……”~
@61 = ~“该死！你已经拿走了？现在的年轻人真是不懂得尊重长辈。不过至少这省得我再向你展示我的*慷慨*了。”~

// 模机工程师对话
@100 = ~“我需要一把钥匙才能让法术在这个地方生效吗？”~
@101 = ~“在这个地方，施法者有什么危险吗？”~
@102 = ~“是的，主管。可以向卢比刚向导索取。”~
@103 = ~“卢比刚向导？我在哪里能找到他？”~
@104 = ~“是的，主管。外部来源的能量连接很可能被此地干扰。”~
@105 = ~“那意味着我不能施法了吗？”~
@106 = ~“肯定。”~
@107 = ~“我该如何保护自己免受这种影响？”~
@108 = ~“需要一个法术钥匙来稳定连接。”~
@109 = ~“我在哪里能找到这个法术钥匙？”~
@110 = ~“可以向卢比刚向导索取。”~
@111 = ~“卢比刚向导被指派了迎接冒险者的任务。他位于卢比刚地城建筑群的入口区。需要一个关键词才能获得法术钥匙。”~
@112 = ~“那是什么？”~
@113 = ~“索取法术钥匙的关键词是‘观星者’。”~
@114 = ~“算了。我还有些别的问题……”~
@115 = ~“明白了。再会。”~

// 模机管事对话
@150 = ~“我被告知要告诉你‘观星者’这个关键词。”~
@151 = ~那生物眨了两下眼，然后开始发出低沉的嗡嗡声，几秒钟后声音消失了。它一言不发，递给你一张像纸一样的布片。~
@152 = ~“谢谢，再会。”~

// 骷髅柱对话
@200 = ~“为什么在没有法术钥匙的情况下，我在位面中施展的法术无法生效？”~
@201 = ~“你被割裂了。你的肉体站在我们面前，但你存在的核心却被隔绝于位面之外。奥术能量需要催化剂才能发挥效果。你存在的核心就是这样的催化剂。法术钥匙可以作为聚焦器。”~
@202 = ~“但为什么在印记城就不是这样？”~
@203 = ~“印记城是‘万门之城’。”柱上的头颅们声音逐渐减低，直到你只能听到个别头颅偶尔发出的低吟。~
@204 = ~“然后呢？”~
@205 = ~柱子沉默了一会儿。最终，头颅们将注意力转回你身上，再次开口说道：“我们没什么可说的了。”~

// 基特拉对话
@250 = ~“作为一个施法者，在这里有什么需要注意的吗？”~
@251 = ~她仔细端详了你一会儿。“也许有。你看起来不像是那种通常被艺术赋予天赋的人。”~
@252 = ~“如果你的法术失效了，那你就需要找到一个法术钥匙。它可以作为某种聚焦器。”~
@253 = ~“我在哪里能找到？”~
@254 = ~“我不知道。”她顿了顿，思索着。“你可以四处找找。诅咒城这里或地下的某处可能有一个。”~

// 交互区域
@500 = ~“石柱”~
@501 = ~石柱周围的地面看起来有些扰动，好像有人在‘不久之前’——也许是过去几年内——走过这里。更彻底的搜索发现柱子一侧有一个微小的开关。~
@502 = ~拨动开关。~
@503 = ~别碰开关。~
@504 = ~你伸手拨动开关。令你惊讶的是，一个伪装很好的盖板松开了，露出了一个隐藏的储藏处。~

// 物品与法术
@1000 = ~混沌海法术钥匙~
@1001 = ~混沌海法术钥匙
重量：0

这个混沌海的符号被刻在一块人皮上。它有金属的气味，但摸起来却很光滑，如同天鹅绒。只要你将其携带在身上，它就能防止你的法术在混沌海位面上失控。~
@1002 = ~外域法术钥匙~
@1003 = ~外域法术钥匙
重量：0

这个外域的符号被刻在一块人皮上。它有种寻常的气味，但摸起来像一块湿布。只要你将其携带在身上，它就能防止你的法术在外域的任何地方失控。~
@1004 = ~法术失败~
@1005 = ~移除法术失败~

// 日志条目
@1500 = ~我从福尔·叉舌那里得到了一把用于巴托地狱位面的法术钥匙。据福尔说，需要法术钥匙来防止我的法术在外层位面上失控。每个位面似乎都需要特定的钥匙。~
@1510 = ~垃圾场看守凯斯，在他从这个地方消失前，留给我一把‘法术钥匙’。显然需要它来防止我的法术在卡瑟利位面上失控。~
@1520 = ~戴娜拉告诉我，悔恨要塞被隔绝了外部能量，这使得在那个地方无法施法。我或许能从过去的我留下的线索中发现更多信息。~
@1530 = ~获取卢比刚法术钥匙。~
@1531 = ~模机工程师告诉我，门厅里的模机负责为前来尝试地城建筑的“冒险者”提供工具。他告诉了我关键词“观星者”，以此指示迷宫入口处的卢比刚向导交出一把法术钥匙。在混沌海位面——卢比刚地城建筑群的建造地——需要这个物品来防止我的法术失控。~
@1532 = ~在说出正确的关键词后，门厅里的模机给了我用于混沌海位面的法术钥匙。~
@1540 = ~骷髅柱向我揭示，我无法在位面中施法是因为我的不朽。我存在的核心，也就是我的凡人性，是施法所必需的。法术钥匙可以作为聚焦器，只要我将其携带在身上。~
@1541 = ~骷髅柱向我揭示，我无法在位面中施法是因为我的不朽。我存在的核心，也就是我的凡人性，是施法所必需的。法术钥匙可以作为聚焦器，只要我将其携带在身上。显然这个限制不适用于印记城，但柱子没有告诉我原因。~
@1550 = ~基特拉告诉我，我可能需要一把‘法术钥匙’，它作为某种聚焦器，来防止我的法术在诅咒城城内或地下失效。她无法告诉我在哪里能找到，所以我得自己留神了。~

// 新对话
@1 = ~“这个城区通常只住着一帮抄写员，但这一片有欢乐堂在里面，所以要热闹些。”~ [MRT088]
@2 = ~“能再次旅行是件好事。妓院是一次学习经历，但我想是时候继续往前了。”~ [FFG011]
@3 = ~“菲尔在这下面有个工作室，对吗？”~ [FFG054]
@4 = ~“你好啊，致命又美味的人儿。”~ [MRT488]
@5 = ~“你好啊，我美丽的苍白美人。”~ [MRT490]
@6 = ~“喔，看看这朵美丽的苍白之花。”~ [MRT491]
@7 = ~“你不需要鉴定法术也知道她想要什么。”~ [MRT492]
@8 = ~“啊，头儿，我要是不回来了，那一定是我正跟那个僵尸妞一起享受‘小死’呢。”~ [MRT493]
@9 = ~“喔……我想跟她葬在一起。”~ [MRT494]
@10 = ~“我超想躺进她的棺材里。”~ [MRT495]
@11 = ~“想合葬吗？”~ [MRT496]
@12 = ~“想交换死亡经历吗？”~ [MRT497]
@13 = ~“你的棺材还是我的？”~ [MRT498]
@14 = ~“你好啊，我美丽的墓地天使。”~ [MRT499]
@15 = ~“别光说我了，行吗？你觉得我怎么样？”~ [MRT500]
@16 = ~“我想我恋爱了。”~ [MRT501]
@17 = ~“我想我是欲火焚身……呃……爱。”~ [MRT502]
@18 = ~“那你当初死的时候是怎样的？”~ [MRT503]
@19 = ~“你知道吗，我真喜欢墓穴霉斑衬托你颧骨的方式。”~ [MRT504]
@20 = ~“你的皮肤是可爱的食尸鬼绿。”~ [MRT505]
@21 = ~“你是最鲜嫩多汁的食尸鬼绿色。”~ [MRT506]
@22 = ~“喔……这对死人的眼睛来说可真是一道风景。”~ [MRT507]
@23 = ~“眼前这腐朽的景象是什么？”~ [MRT508]
@24 = ~“喔……这个的零件几乎都在呢！”~ [MRT509]
@25 = ~“嘿，头儿……这个僵尸妞在踩我的地盘呢，你懂我意思吗？”~ [MRT510]
@26 = ~“你好。我是莫提。你叫呃……什么来着？”~ [MRT511]
@27 = ~“尸僵从未如此好看。”~ [MRT512]
@28 = ~“喔……你从天堂掉下来的时候摔伤了吗？”~ [MRT512D]
@29 = ~“嘘……嘿头儿，你看见她看我的眼神了吗？嗯？看见了吗？你看见她盯着我枕骨的曲线看了吗？没错宝贝。”~ [MRT513]
@30 = ~“喔，我甜美的脏东西。”~ [MRT514]
@31 = ~“蜂巢区变化太快了。自从我上次离开这里，它已经大变样了。”~ [FFG053]
@32 = ~“失宠，我害怕。抱抱我？”~ [MRT163]
@33 = ~“你也许害怕，莫提，但换作是我要抱你的话，我也会害怕。”~ [FFG135]
@34 = ~“失宠，你想把我放进你的物品栏里吗？”~ [MRT162]
@35 = ~“恐怕我的背包会相当闷热呢，莫提。”~ [FFG136]
@36 = ~“失宠……我需要一次感官触碰！”~ [MRT164]
@37 = ~“哦莫提，你就不觉得不正经会累吗？”~ [FFG137]
@38 = ~“那么，你到底带了多少灵魂进入无底深渊？”~ [ANA311B]
@39 = ~“事实上，一个也没有。这让我的青春期相当难熬。但我敢肯定你对那并不陌生。”~ [FFG144]
@40 = ~“我希望有条猎犬在你的铺盖卷里下崽。”~ [ANA586A]
@41 = ~“永远别相信塔那厘，我就是这么说的。”~ [ANA314B]
@42 = ~“我同意。塔那厘天性就是不可预测。”~ [FFG145]
@43 = ~“你也许该自己单干了。”~ [ANA310A]
@44 = ~“我觉得是时候去‘你之湖’游个泳了。”~ [FFG139]
@45 = ~“哦，不。女士优先。”~ [ANA310D]
@46 = ~“你准备好离开了吗，邪魔？”~ [ANA308B]
@47 = ~“事实上，我相当享受这陪伴。针对我的怨念让我感到精神焕发。”~ [FFG142]
@48 = ~“你有没有想过打理一下你的头发？”~ [FFG143]
@49 = ~“哦，在打量我们的脖子准备大吃一顿，是吗？”~ [ANA313A]
@50 = ~“别盯着我的尾巴看，你这骷髅！”~ [ANA305E]
@51 = ~“我没盯着看。我在流口水。”~ [MRT196]
@52 = ~“嘿莫提，想听好消息吗？你快秃了。”~ [ANA578AA]
@53 = ~“噢，你的话刺痛我了，呃……像被东西蜇了一样。”~ [MRT458D]
@54 = ~“你的血管里流的是冰水吗？”~ [MRT481]
@55 = ~“继续贫嘴吧，骷髅，我倒要看看你血管里有什么。”~ [ANA574A]
@56 = ~“我敢打赌比你多十倍。”~ [MRT528]
@57 = ~“小邪魔，那口音再重一点你就没法呼吸了。”~ [MRT545]
@58 = ~“喔，我要是你，就准备好捡自己的牙了。”~ [ANA578A]
@59 = ~“经历过，做过了，小邪魔。痛苦：是啊，那是老一套了。”~ [MRT535]
@60 = ~“注意：莫提。我有个问题。什么是命运？”~ [NOR321A]
@61 = ~“失宠一边在我后脑勺上挠痒，一边在我耳边唱《光之奏鸣曲》。”~ [MRT574]
@62 = ~“命运似乎并不具备许多人认为的那种复杂性。”~ [NOR322]
@63 = ~“要是情况变得更糟，我还不如去女士的阴影里跳舞呢。”~ [MRT552A]
@64 = ~“你能不能说点正经的？”~ [ANA287C]
@65 = ~“哦！对不起……你知道，我本来想说要是情况变得更糟，我还不如去拿痛苦女士当笔尖蘸墨水呢。”~ [MRT552B]
@66 = ~“我欣赏你的活力，莫提，但也许你可以把它转向内心。”~ [FFG138]
@67 = ~“哎呀……你们这些女人都抱成一团。”~ [MRT552C]
@68 = ~“你知道吗，有时候我真的很想念拥有身体的感觉。”~ [MRT543A]
@69 = ~“哼，听听你说的话！不难看出它为什么要离你而去。”~ [ANA613C]
@70 = ~“你的话语就像鞭子抽在我赤裸的肩头。”~ [MRT460A]
@71 = ~“莫提，我很好奇，你的身体怎么了？”~ [FFG326]
@72 = ~“大概是去找你了。”~ [MRT543B]
@73 = ~“滚开，骷髅！”~ [ANA316A]
@74 = ~“聊聊你自己吧，达肯。”~ [FFG122]
@75 = ~“‘泽斯’是那些知晓泽西蒙之言的人。他们保护吉斯泽莱社群免受一切威胁，无论是肉体的还是精神的。”~ [DAK043]
@76 = ~“头儿，我们真该甩掉这个家伙，免得他想起你上次干过的事。”~ [MRT475CA]
@77 = ~“跟神明说去吧，机模。”~ [MRT570B]
@78 = ~“通过观察、感知和体验，多元宇宙的真理将被揭示。”~ [FFG104]
@36644 = ~背刺！二倍 [阿娜]~ [ANA522D]
@36924 = ~背刺！三倍 [阿娜]~ [ANA523B]
@36925 = ~背刺！四倍 [阿娜]~ [ANA524B]
@36926 = ~背刺！五倍 [阿娜]~ [ANA520F]
@61916 = ~达肯 稀有4 1~ [DAK027B]