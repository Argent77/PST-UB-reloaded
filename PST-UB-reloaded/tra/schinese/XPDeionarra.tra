@1 = ~“我会告诉你女儿，你在临终前还惦念着她，梅贝丝。愿诸位位面仁慈地接纳你。”~
@2 = ~“你好，凯赛-瑟瑞斯。我带来了你母亲的消息。”~
@3 = ~凯赛叹了口气。“你一定要总是提醒我吗？你现在告诉我这件事，并不会比我第一次听到时更让我对自己的血统感到高兴。”~
@4 = ~“她死了，凯赛。”~
@5 = ~“好吧，我不会再拿她的事来烦你了。再会。”~
@6 = ~凯赛猛地停住，然后笑了起来。“你一定是在开玩笑。解密者死了？怎么可能？有什么东西能杀得了她？”~
@7 = ~“我被迫自卫杀了她。我并不以此为乐。”~
@8 = ~“我杀了她。她是个巨大的邪恶，就像你自己告诉我的那样，必须将其终结。”~
@9 = ~“她死在我手上。那鬼婆罪有应得，你很清楚这点。”~
@10 = ~“我……明白了。”几种矛盾的表情掠过她那异域风情的面容，难以解读。“可你为什么觉得有必要告诉我这个？”~
@11 = ~“因为还有更多。她在临终前提到了你。”~
@12 = ~“我想也没什么必要。算了。”~
@13 = ~凯赛畏缩了一下，看起来很害怕。“她提到了？愿诸神力帮我……她说了什么？”~
@14 = ~“请让我解释。确切地说，提到你的并非解密者本人。解密者所有这些年来一直还住在印记城，在某种意义上，或者说她的各种面向如此。其中一个面向是个老草药师兼接生婆，住在拾荒者广场。她名叫梅贝丝。”~
@15 = ~“梅贝丝？我听说过她，但从没见过她。她是蜂巢区少数几个连女士区的人偶尔也会来找的人，为了她的符咒和草药。”~
@16 = ~“是的，那听起来就像是我说的那个女人。在我于女士迷宫里与解密者对质之后，我去找了梅贝丝，结果发现梅贝丝快要死了。作为解密者的一个面向，真正的解密者死后，她也活不了多久。”~
@17 = ~凯赛专注地听着，被你的故事迷住了。“接着说……”~
@18 = ~“梅贝丝死前，她遗憾地说自己没法对你表达善意，因为用她的话说，‘诸位面上有句谚语，鬼婆的善意比她的恨意更残忍，会毒害它所触及的一切。’”~
@19 = ~“你是说这个梅贝丝，她不像我母亲那样邪恶？你刚说她是我母亲的一部分。”~
@20 = ~“一个面向，是的。我觉得，就连解密者也有善良的一面，我相信梅贝丝是她那一部分最纯粹的体现。她对我展现了善意，而且所求甚少。我对她很感激。”~
@21 = ~凯赛看着你，现在更加矛盾了。“你觉得她的这一部分想要成为我的母亲，对我表达善意，却又担心自己的本性会给我带来伤害？”~
@22 = ~“这就是我从她的遗言中总结出来的，没错。”~
@23 = ~她不由自主地打了个寒颤，然后叹了口气。“我不确定你是否该告诉我这些。但现在我知道了，我就必须知道全部的真相。给我点时间，我要问问我父亲。”~
@24 = ~“别着急。如果你不介意，我就在这里等。我也想知道他会说些什么。”~
@25 = ~凯赛沉默地凝视了你一会儿，然后点了点头。“给我点时间。”她转过身去，开始像之前那样低声喃喃自语……她周围的空气似乎微微闪烁，并弥漫着一股铜锈味，像是温热的血液……~
@26 = ~你靠向凯赛，试图听清她在低语什么。

“霍加扎宁内尔，伊萨格的放逐王子，血影侯爵，我的父亲，听我说，因为我必须再次呼唤您……”~
@27 = ~她继续说着，声音低沉而轻缓，你只能从她的声音里听到深沉的悲伤。~
@28 = ~凯赛回到你身边，她那异域风情的眼眶里噙满了泪水。“我父亲证实了你的说法。我母亲确实已经不在人世了。”~
@29 = ~“就如我所说。我很遗憾，凯赛。我不打扰你思考了。再会。”~
@30 = ~“就如我所说。再会了，凯赛-瑟瑞斯。”~
@31 = ~“谢谢你特意来告诉我。总想着她哪天会来找我，情况会更糟。再会。”~
@32 = ~“请稍等一下。还有别的事。我父亲说，你在最后对我母亲展现了善意，他想回报这份善意。”~
@33 = ~“善意？你是说我给她的那颗花园里的倒刺种子？”~
@34 = ~“正是。我父亲让我告诉你，你寻找的东西就在你的梦里。”~
@35 = ~“可我不做梦。打从我记事起就没做过。”~
@36 = ~“铸造厂里有个人声称能造出一台让我做梦的机器，但我还没跟进完那件事。”~
@37 = ~“我找到了再次做梦的方法，但并没有在梦里找到我寻找的任何东西。”~
@38 = ~“父亲说是有办法的。你需要自己去找。等你做过梦之后，再回来找我。”~
@39 = ~“真的？真奇怪。如果你相信他，那我建议你完成他的机器并用它。等弄好了就回来找我。”~
@40 = ~“好吧。如果我成功体验到了梦境，我会回来的。再会。”~
@41 = ~“或许你应该再试试。或许……”~
@42 = ~她叹了口气，端详着你，然后似乎不情愿地做出了一个决定。“或许这件事我能帮上忙。你知道我一直对梦境着迷。了解了自己的血统后，我才明白了原因。我体内流着灰色荒野的血，意味着我对梦境有掌控力，虽然我从未使用过，因为我不知道自己拥有这力量。但或许这次我可以为你使用它。众所周知，鬼婆能驾驭人的梦境，将其变为噩梦，并驾着它们直至人死去。”~
@43 = ~“我怀疑自己做不来那种事，也不想做，但我有可能在你的梦里陪伴你，也许能帮你找到我父亲所说的那个东西。你愿意吗？我知道这会极大地侵犯隐私，但也许我能提供一些帮助，让你觉得这么做是值得的。”~
@44 = ~“我的女士，我会欢迎你进入我的梦境，因为我猜无论如何你都会在那里占有一席之地。”~
@45 = ~“我会感激你提供的任何帮助，凯赛。十分感谢。”~
@46 = ~“这让我觉得不舒服。抱歉，我想我得拒绝，不过谢谢你的提议。”~
@47 = ~“我的梦是我自己的事，半鬼婆。别插手。”~
@48 = ~凯赛向你露出灿烂的、带着尖牙的微笑。“天呐，你*真*是个迷人的家伙。也许等我们办完事后，可以沿着这些线索再多聊聊。”~
@49 = ~在你眼角余光中，你注意到阿娜绷紧了身体，她的尾巴来回抽动，但她什么也没说。~
@50 = ~在你眼角余光中，你注意到失宠为此挑起了一条精致的眉毛，但她仍然保持沉默。~
@51 = ~“好吧。给我点时间准备一下。一天后再来，然后我们去找你提到的那个造梦机。”~
@52 = ~“我找到了做梦的方法，凯赛。铸造厂里有一台机器，是我以前的某个化身很久以前委托制造的。它让我能够做梦。”~
@53 = ~“你准备好了吗，凯赛？我想是时候探索我的梦境了。”~
@54 = ~“还没有。我还需要一点时间。记住，我以前从没试过这个，而且最近才知道自己甚至有能力做到。不过，我试着练习一下我想象中的方法应该用不了多久。晚点再来吧。”~
@55 = ~凯赛看起来有点邋遢，但奇怪地更……自信……了，比你上次见她时。“又见面了。在你问之前，是的，我确定现在能帮你了。昨晚兰妮自愿让我探访她的梦。我想着，如果有什么人的梦是相对安全可以探访的，那应该就是她的了。”她停顿了一下，然后低语道。“我*完全*没想到。我觉得*她*自己也没想到。”~
@56 = ~莫特上下跳动着。“哦，你*不能*就这么算了。得了吧。我*一定*要知道。”~
@57 = ~凯赛摇摇头。“不行，我答应过要尊重她的隐私。我不会分享那里的内容。我甚至都不该说那么多的。我只是……还在……缓过来。”她闭了一会儿眼睛，回忆起那个梦境时咽了口唾沫。~
@58 = ~“那太可惜了，我和莫特一样好奇。但好吧，我不会追问的。”~
@59 = ~“真的吗？她的梦是什么样的？”~
@60 = ~“我理解。请记得替我感谢她在这件事上的帮助。”~
@61 = ~“我不惊讶。最甜美的人总是隐藏着最阴暗的想法。你看到了什么？”~
@62 = ~莫特开始用前额撞旁边的墙。“这……”*砰*“诸位面……”*砰*“太……”*砰*“残……”*砰*“酷了！*”~
@63 = ~“谢谢你的理解。我向你保证，我会对你梦中发现的任何东西同样保密。我们可以走了吗？”~
@64 = ~“我准备好了，我的女士。”~
@65 = ~“走吧。还有，凯赛？再次感谢你。”~
@66 = ~“我改变主意了。我不想做这个了。”~
@67 = ~“好吧。但我仍然觉得欠你的。如果你改变主意，我仍然会尽力帮忙。”~
@68 = ~“我不该和你一起进去，但我应该能从外面进入你的梦境。你可能能在梦里感知到我，也可能不能——兰妮就没能。”她又打了个寒颤，莫特沮丧地嘟囔着。“进去吧。我会在那里看着，并留意任何对你有帮助的东西。”~
@69 = ~“我不该和你一起进去，但我应该能从外面进入你的梦境。你可能能在梦里感知到我，也可能不能——兰妮就没能。”她又打了个寒颤。“进去吧。我会在那里看着，并留意任何对你有帮助的东西。”~
@70 = ~“哦，还有件事。我没有能力让你把梦里找到的任何东西带出来，但我*应该*能让你把东西*带进去*。如果有必要，你进入机器时身上携带的任何东西，在你的梦里都能用。不过要小心。你在梦里消耗或丢弃的任何东西，很可能就永远消失了。祝你好运！”~
@71 = ~你再次发现自己站在了绞刑架的绞索下。那沙哑的声音咯咯笑道，“*又*一个梦？又一个！又一个！哈哈哈！”~
@72 = ~和之前一样，你的身体出奇地轻盈飘忽，像是失去了对它的控制。不过，梦境很快就破碎了，每一个画面刚出现就从你脑海中溜走。醒来之后，你什么也记不住。~
@73 = ~你再次发现自己站在了绞刑架的绞索下。你发现自己的左手紧紧抓着一颗倒刺种子。那沙哑的声音咯咯笑道，“*又*一个梦？又一个！又一个！等等？谁？入侵者！”~
@74 = ~和之前一样，你的身体出奇地轻盈飘忽，像是失去了对它的控制。然而这次，吹动你的风似乎被人引导着。你知道你不是一个人，虽然你感觉不到任何其他灵魂。~
@75 = ~你再次发现自己站在了绞刑架的绞索下。那沙哑的声音似乎被激怒了。“*不*！梦境不是用来塑造的！入侵者！鬼婆！滚开！”~
@76 = ~和之前一样，你的身体出奇地轻盈飘忽，像是失去了对它的控制。然而这次，你能感觉到凯赛在塑造梦境，把你带回到印记城之下的梦境里。你隐约感觉到有第三个存在，但你无法辨认出那是谁。~
@81 = ~你发现自己身处停尸房，周围是那些你用各种手段强迫跟随你的人。他们正在对你说话，但他们的话语就像无数拖沓的脚步声一样从你身边掠过。当他们喋喋不休地问着那些愚蠢问题时，你心里在盘算着为这次旅程所做的所有准备……~
@82 = ~你发现自己身处欢乐堂你的房间里，你走向你委托制作的那个储物柜，只有知道里面有什么才能打开它。你走过去，要把三样东西放进去，这是你留给未来化身的遗产的最后部分，以防你前往负能量位面的旅程不如计划那般顺利。~
@83 = ~从你视野的边缘，走过来一个极具异域风情的女人，长着尖牙和蓝色皮肤。你可以发誓你认识她，可你又确信以前从未见过她。这些事情怎么会同时成立，不知何故你似乎并不怎么在意。~
@84 = ~“你是谁？”~
@85 = ~“哦，只是个有志于成为感觉者的家伙，在欢乐堂里四处看看。我从你敞开的门里看到了你，忍不住想多了解你一下。我能问一下你在做什么吗？”~
@86 = ~“我在准备一次*非常*危险的旅程。总得提前想好几步。我有健忘的毛病，所以我只是给自己留些纪念品。”~
@87 = ~“我明白了，真有趣！比如呢？”她看向你手里拿着的东西，可当你低头看时，你只拿着三颗倒刺种子。~
@88 = ~“啊，这个嘛，有把钥匙……我把这些门设计成必须从*里面*使用钥匙。你必须能清晰地想象出里面的某样东西才能打开它们。很聪明，嗯？还有留给自己的口信，不过你不能读。最后，是我前几天在印记城之下捡到的一把还算结实的小武器。我用不上它，但也许哪天我能用上，所以我干脆把它留给下一个我了。”~
@89 = ~“哦哦，印记城之下？我从来没去过那里！”她诱惑般地靠近你，把手放在你胸口，你忍不住欣赏起她那惊人丰满的身材。“我听说那里非常危险。你能让我看看里面什么样吗？”~
@90 = ~“嗯。好啊，为什么不呢？戴娜拉暂时不会回来，她去探望她那个傻瓜父亲了。只要你保证不告诉她就行，她是个善妒的家伙，而我还用得着她。”~
@91 = ~你不能确定那女人刚才是不是做了个鬼脸，因为那表情几乎瞬间就消失了。“哦，当然，我一个字都不会说。我只是很想看看那里。”~
@92 = ~你把倒刺种子放进储物柜，关上了门。“那我们走吧。”~
@93 = ~突然间你又回到了印记城之下，从东南方向的通道传来凶恶魔兽的吼叫声，在走廊里回荡。“听到了吗？我几天前杀了那些家伙。而且是我一个人杀的，”你撒谎道。“我在那个房间里也找到了个不错的宝贝。”~
@94 = ~蓝皮肤女人娇声喘了口气。“真的吗？我能看看吗？你能教教我怎么杀那些凶猛的野兽吗？那太迷人了。”~
@95 = ~你知道这女人在操纵你，因为你自己也经常这么做，但不知何故你无法抗拒。“那很容易。就待在这儿，我马上回来。”~
@96 = ~当你走向那些生物时，突然间，你不再是应那个女人要求而站在那里。你是第一次接近这些生物，探索印记城之下，为你即将到来的旅程寻找有用的东西。~
@97 = ~最后一只迷诱魔倒下了，你搜索房间，看看它们是否囤积了什么有用的东西。突然，在一堆恶魔的废弃物下面，你的目光落在了一件强大的武器上，你从未见过这样的东西。一股可怕的威能气息从这件巨大的武器中散发出来。锋利而有力的线条装饰着它的柄身，径直通向一个完美的球体，那就是这件武器的打击部。完美的弧形尖刺从那形状完美的球体上伸出，营造出一种既引人注目又令人敬畏的形象。一股充满活力的皇家紫色光晕笼罩着这件强大的武器。~
@99 = ~你发现自己回到了铸造厂。凯赛的胸口剧烈起伏着，她试图喘过气来。过了一会儿，她低语道：“那真是……一次强烈的体验，我得说。我想我能把你带回那个梦境，如果你想准备一下再回去试试的话。你需要在你梦里击败所有那些生物，才能找到你寻找的东西。我会在这里等你。我想研究一下这台机器，如果你允许的话。我觉得我能从它身上学到很多关于梦境的知识。这真是一项了不起的成就。”~
@100 = ~“当然可以，凯赛。谢谢你的帮助。我会做好准备，再回来试试。”~
@101 = ~“我明白了，所以你陪着我进入我的梦境，然后说服我被凶残的恶魔撕碎。你身上你母亲的那部分比我想象的还要多。我们到此为止吧。”~
@102 = ~凯赛愤怒地对你低吼，上唇向后翻起，露出尖牙。“好！我只是想帮忙。那些生物在现实世界里根本伤不到你……再说你难道不是永生不死的吗？如果它们吓到你了，那你可不像我想象的那么有男子气概。再见！”~
@103 = ~你听到一个女声穿过尖牙在你周围低语。“成功了……”你周围的世界开始瓦解……~
@104 = ~你发现自己回到了铸造厂。凯赛看起来筋疲力尽，但得意洋洋。“好了。你应该去我们在你梦里看到的欢乐堂的那个房间。那里有一个密封的储物柜，必须知道里面有什么才能打开。记住你看到的那把连枷，打开的时候在心里想象它。我父亲说，在那里你会找到你一直寻找的其他东西。”~
@105 = ~“非常感谢你，凯赛。你帮了我的大忙，我无以为报。”~
@106 = ~“别这么说。我认为我们现在扯平了。而且我想我不会再回妓院了。我想我在那里能学的都学到了，现在我还有其他兴趣和经历要去追求，比如进一步研究这台机器。”~
@107 = ~“别这么说。我认为我们现在扯平了。而且我想我不会再回妓院了。我想我在那里能学的都学到了，现在我还有其他兴趣和经历要去追求，比如进一步研究这台机器。失宠夫人，您允许我离开吗？”~
@108 = ~“当然，凯赛-瑟瑞斯，你不需要我的允许。能收你为学生是我的荣幸。谢谢你对我们领袖的帮助，我希望我们还能再见。”~
@109 = ~凯赛走近你，把手放在你的胸口上。“你是个非常有魅力的男人，我承认我发现你的兴趣让我受宠若惊。也许有一天我们可以更好地了解彼此。”她吻了吻你的脸颊，当她轻轻低吼时，你感觉到她的尖牙粗糙地划过你的脸颊。“但现在不是时候。你显然有重要的事要去做，我现在也一样。”~
@110 = ~阿娜的尾巴抽动着。“那你最好赶紧去处理它们，快点，你这浪蹄子！”~
@111 = ~“冷静点，阿娜。凯赛不是什么浪蹄子，她值得更好的对待。”~
@112 = ~“阿娜说得对，凯赛。我不想耽误你追求自己的道路，我也不能耽误我的。”~
@113 = ~“祝你好运，我神秘莫测又带来启示的古怪绅士。不管结果如何，我*的确*希望我们能再见面。”她紧紧地拥抱了你一下，然后离开了。~
@114 = ~“哦，你回来了。想再试试击败你梦里的那个生物吗？”~
@115 = ~“是的，我想我现在准备好了。你会在那里帮忙吗？”~
@116 = ~“当然。很抱歉在战斗中我不能帮你更多，但我可以观察，如果我发现有任何办法能帮到你，我会的。”~
@117 = ~你发现自己回到了印记城之下。恶魔的嚎叫继续从东南走廊传来。~
@118 = ~“你真是个性感得要命的男人。*求你了*，再给我看看你是怎么打败那些巨大怪兽的！那肯定是次非常刺激的经历，欢乐堂的姑娘们会嫉妒死的，而我会非常感激的。”~
@119 = ~“好吧。在这里等着。”~
@121 = ~“我们需要再谈谈你母亲的死，凯赛。”~
@122 = ~“凯赛，我必须走了。也许我们可以以后再继续谈。再会。”~
@123 = ~“太棒了！你找到你要找的东西了吗？”~
@124 = ~“不幸的是，没有。我梦到了我已经经历过的事情。解密者的迷宫，骷髅柱……但并没有揭示任何我还不知道的事情。”~
@125 = ~“实际上，我宁愿不谈。但没有，我没找到什么新东西。”~
@126 = ~“让我准备一下，然后我们就可以走了。我很快就回来。”~
@127 = ~“那太可惜了，我很好奇。但好吧，我不会追问的。”~
@128 = ~“我*一定*要知道！你*必须*告诉我，女人！”~
@129 = ~“恐怕我必须坚持。告诉我兰妮的梦境，凯赛。”~
@130 = ~“哇……头儿……听着，我也想知道，但没关系，算了吧……”~
@131 = ~“我……明白了。我想我改变主意了，我不想再帮你了。请离开。”~
@132 = ~“告诉我她的梦，半鬼婆，不然我就挖出你的心！”~
@133 = ~“我道歉……我……不知道刚才是怎么了。你可以保留她的秘密。”~
@136 = ~“谢谢你告诉我我母亲的命运，但我想我们之间没什么好说的了。再见。”~
@137 = ~“我改变主意了，凯赛。我想请你帮我解开我的梦境。”~
@138 = ~凯赛似乎恢复了镇静。她用深红的眼睛打量着你。“很高兴再见到你。你改变主意了吗？我们该探索你的梦境了吗？”~
@141 = ~失宠的目光在你、阿娜和凯赛之间来回扫视，一条精致的眉毛困惑地挑起。她也什么也没说。~
@142 = ~“多么了不起的机器啊！”~
@143 = ~“是的，我确定那部分能触及潜意识的第三层……”~
@144 = ~“哦！原来那部分是这么工作的！”~
@145 = ~“嗯，鸟笼子在里面做什么？”~
@146 = ~凯赛冲到你身边。“哦，不！又来了？你这可怜的家伙！那一定很疼，即使只是在梦里。”~
@147 = ~“我没事，凯赛，谢谢你。看来我还得再多准备准备。”~
@148 = ~“不，现在不行。等我准备好了再回来。”~
@149 = ~这个密封的储物柜上没有锁、门闩或其他明显的开启方式。~
@150 = ~梅贝丝已经不在了，随着解密者的魔法丝线在位面间散开，她的整个存在也随之消解。妓院里的凯赛-瑟瑞斯或许应该知道她母亲的命运。~
@151 = ~凯赛告诉我，她父亲暗示我能在梦里找到有价值的东西。可我不做梦。如果我不知怎的恢复做梦的能力，我应该再和凯赛谈谈。~
@152 = ~凯赛告诉我，她父亲暗示我能在梦里找到有价值的东西。可我不做梦。铸造厂里那个叫山德的家伙倒是提到他在造一台能让我重新做梦的机器。我或许该跟进一下这件事。~
@153 = ~凯赛告诉我，她父亲暗示我能在梦里找到有价值的东西。可是我在山德的织梦器里的梦并没有向我展示任何有价值的东西。~
@154 = ~我把在织梦器里做梦的事告诉了凯赛。她说她愿意跟我去铸造厂帮我解开我的梦境。~
@155 = ~凯赛说我需要击败我梦里的恶魔才能找到对我有价值的东西。~
@156 = ~击败了我梦里的迷诱魔后，我发现了一把强力的连枷，是我之前的化身放在欢乐堂我房间里的一个储物柜里的。柜门靠知道里面有什么东西才能打开。嗯，我好好看了看那把连枷……~
@157 = ~我打开了欢乐堂我房间里的储物柜。除了梦里那把强力的连枷，我还找到了一支羽毛笔，它揭示了戴娜拉遭遇的悲剧我应负的真正责任。我想我应该把真相告诉她父亲，辩护者伊安尼。~
@200 = ~羽毛笔
重量：0

你在欢乐堂自己房间的储物柜里找到了这支羽毛笔。它看起来非常普通。~
@201 = ~你决定试着用你的新笔在日记里写一篇关于你在储物柜里发现的东西的记录。然而，当笔尖触碰到纸面的那一瞬间，它突然自己开始书写，飞速地写画着，几乎拖着你的手在纸面上飞舞，刻下一些似乎并非出自你本意的文字。

它写道：

“如果一切按计划进行，你按照我们随身携带的日记里我的指示，找到了我留给安那其主义者们、你为了打开我们房间的储物柜而想象出来的那颗玻璃眼珠，并拿到了这支笔。太好了。我想确保发现这一切的是个足智多谋又聪明的化身，而非其他。现在仔细听好，因为你有一项任务要做。”~
@202 = ~羽毛笔继续写道：“如果你在读这段文字，那意味着我没能击败我们的敌人。你现在肯定已经知道，一股恶意的力量不断派遣暗影来袭击我们，一次又一次地杀死我们。我穿行诸位面寻找他的身份，我相信我至少找到了他的位置。他住在负能量位面的一座巨大要塞里。更重要的是，我知道怎么找到他。”~
@203 = ~羽毛笔继续写着，描述了你已经从崔雅斯那里了解到的关于停尸房里传送门的信息，以及你需要做些什么来激活它。~
@204 = ~羽毛笔继续写道：“你必须继续我的工作，消灭这个生物，这样我们才能最终从他那里得到安宁。为了实现这个目标，你可以利用任何你需要的人。如果他们不知怎的能在我们的旅程中幸存下来，就去找那个吉斯泽莱人达肯，他的刀刃有潜力成为最强大的武器。带上那颗骷髅头，他会有用的，但无论如何，别相信他。那个老弓箭手撒卡里亚是个瞎了眼、醉醺醺的蠢货，但他的目标从不落空。至于那个女孩戴娜拉，如果我的后备计划奏效，那么你不会在活人中找到她，但她会比他们任何人都对你有用。”~
@205 = ~羽毛笔继续写道：“你会拥有一个我没有的优势，你看。她会跟我一起去要塞，如果我运作得当，她会死在那里。但她非常爱我们，那愚蠢的东西，就像清除者说的，像她那样强烈的情感会将我们与这个世界联系在一起。她会同时存在于那个位面和我们这个位面，大概在她被安葬的地方。她可以为你监视我们敌人的行动，但别犯傻告诉她她的用途，她很可能不会乐意，那就会终结她对我们用处。”~
@206 = ~羽毛笔继续写道：“明智地利用她能给你的信息，别让多愁善感妨碍你，彻底除掉这个杀手。”~
@207 = ~羽毛笔停了一会儿，然后用更匆忙的笔迹补充了最后一句：“又及：我前几天在印记城之下发现了这把连枷。我无法使用它，但也许你可以，所以我想就把它留在这里给你了。好好享用。”~
@208 = ~羽毛笔停了下来。控制它移动的附魔似乎耗尽了。现在看来它不过是一支极其普通的羽毛笔了。~
@209 = ~继续写。~
@210 = ~试着用它写字。~
@211 = ~把羽毛笔收起来。~
@212 = ~如果一切按计划进行，你按照我们随身携带的日记里我的指示，找到了我留给安那其主义者们、你为了打开我们房间的储物柜而想象出来的那颗玻璃眼珠，并拿到了这支笔。太好了。我想确保发现这一切的是个足智多谋又聪明的化身，而非其他。现在仔细听好，因为你有一项任务要做。

如果你在读这段文字，那意味着我没能击败我们的敌人。你现在肯定已经知道，一股恶意的力量不断派遣暗影来袭击我们，一次又一次地杀死我们。我穿行诸位面寻找他的身份，我相信我至少找到了他的位置。他住在负能量位面的一座巨大要塞里。更重要的是，我知道怎么找到他。

……这里写了一大段话，与你已经从崔雅斯那里了解到的情况相关，包括如何以及在哪里可以到达你的敌人的要塞……

你必须继续我的工作，消灭这个生物，这样我们才能最终从他那里得到安宁。为了实现这个目标，你可以利用任何你需要的人。如果他们不知怎的能在我们的旅程中幸存下来，就去找那个吉斯泽莱人达肯，他的刀刃有潜力成为最强大的武器。带上那颗骷髅头，他会有用的，但无论如何，别相信他。那个老弓箭手撒卡里亚是个瞎了眼、醉醺醺的蠢货，但他的目标从不落空。至于那个女孩戴娜拉，如果我的后备计划奏效，那么你不会在活人中找到她，但她会比他们任何人都对你有用。

你会拥有一个我没有的优势，你看。她会跟我一起去要塞，如果我运作得当，她会死在那里。但她非常爱我们，那愚蠢的东西，就像清除者说的，像她那样强烈的情感会将我们与这个世界联系在一起。她会同时存在于那个位面和我们这个位面，大概在她被安葬的地方。她可以为你监视我们敌人的行动，但别犯傻告诉她她的用途，她很可能不会乐意，那就会终结她对我们用处。

明智地利用她能给你的信息，别让多愁善感妨碍你，彻底除掉这个杀手……

又及：顺便说一句，我前几天在印记城之下发现了这把连枷。我无法使用它，但也许你可以，所以我想就把它留在这里给你了。好好享用。~
@213 = ~最后一篇日记不是我写的……是我在欢乐堂自己房间储物柜里找到的那支奇怪的羽毛笔，在我用笔尖碰到纸的那一刻写下的。写完那篇之后，它就停了。现在看来它不过是一支极其普通的羽毛笔了。~
@214 = ~你把羽毛笔碰到纸上，但它似乎已经没有东西可写了。现在看来它是一支极其普通的羽毛笔了。~
@215 = ~集中注意力，试着把笔从日记本上拿开。~
@216 = ~你竭尽全力想停止书写，但你无能为力。那支笔有它的信息要传达，而且它被施加的任何附魔都强大到足以迫使你让它写完。~
@217 = ~你在欢乐堂自己房间的储物柜里找到了这支羽毛笔。它看起来非常普通。~
@218 = ~想象你在织梦器里看到的那把连枷。~
@219 = ~别碰储物柜的门。~
@220 = ~你专注于对那把连枷的记忆，想象着沿着柄身延伸到带刺球体的线条，想象着围绕着它的力量光环。你听到咔哒一声，隔间裂开了一条缝，足以让你把手指伸进去，把门完全打开。~
@300 = ~戴娜拉真相扩展模组~