// 戴娜拉对话
@0 = ~“此地会压制所有非本位面的能量。若你依靠附魔或法术来保护自己，必将陨落。”她用更为急切的语气继续说道。“寻找你上次造访此地时留下的线索。”~

// 福尔对话
@50 = ~“关于巴托地狱，还有什么我需要了解的吗？”~
@51 = ~“那个地方的魔法*可能*会受到干扰。但像你这样……有分量的人，应该能毫发无损地穿越那片平原。”~
@52 = ~“能再详细解释一下吗？”~
@53 = ~“你非要问？哼！外层位面对于你这样的人来说，可能距离魔法的源头太远了，除非……”~
@54 = ~“除非什么？”~
@55 = ~“除非你手头有一个‘钥匙’来聚焦魔法能量。”~
@56 = ~“你有这样的钥匙吗？”~
@57 = ~“呃？有，这东西可能就丢在这附近的什么地方。”~
@58 = ~“请把它给我！”~
@59 = ~“哼！给你。*还有*什么我能效劳的？”~
@60 = ~“哼！当然……”~
@61 = ~“该死！你已经拿走了？现在的年轻人真是不懂得尊重长辈。不过至少这省得我再向你展示我的*慷慨*了。”~

// 模机工程师对话
@100 = ~“我需要一把钥匙才能让法术在这个地方生效吗？”~
@101 = ~“在这个地方，施法者有什么危险吗？”~
@102 = ~“是的，主管。可以向卢比刚向导索取。”~
@103 = ~“卢比刚向导？我在哪里能找到他？”~
@104 = ~“是的，主管。外部来源的能量连接很可能被此地干扰。”~
@105 = ~“那意味着我不能施法了吗？”~
@106 = ~“肯定。”~
@107 = ~“我该如何保护自己免受这种影响？”~
@108 = ~“需要一个法术之钥来稳定连接。”~
@109 = ~“我在哪里能找到这个法术之钥？”~
@110 = ~“可以向卢比刚向导索取。”~
@111 = ~“卢比刚向导被指派了迎接冒险者的任务。他位于卢比刚地城建筑群的入口区。需要一个关键词才能获得法术之钥。”~
@112 = ~“那是什么？”~
@113 = ~“索取法术之钥的关键词是‘观星者’。”~
@114 = ~“算了。我还有些别的问题……”~
@115 = ~“明白了。再会。”~

// 模机管事对话
@150 = ~“我被告知要告诉你‘观星者’这个关键词。”~
@151 = ~那生物眨了两下眼，然后开始发出低沉的嗡嗡声，几秒钟后声音消失了。它一言不发，递给你一张像纸一样的布片。~
@152 = ~“谢谢，再会。”~

// 骷髅柱对话
@200 = ~“为什么在没有法术之钥的情况下，我在位面中施展的法术无法生效？”~
@201 = ~“你被割裂了。你的肉体站在我们面前，但你存在的核心却被隔绝于位面之外。奥术能量需要催化剂才能发挥效果。你存在的核心就是这样的催化剂。法术之钥可以作为聚焦器。”~
@202 = ~“但为什么在印记城就不是这样？”~
@203 = ~“印记城是‘万门之城’。”柱上的头颅们声音逐渐减低，直到你只能听到个别头颅偶尔发出的低吟。~
@204 = ~“然后呢？”~
@205 = ~柱子沉默了一会儿。最终，头颅们将注意力转回你身上，再次开口说道：“我们没什么可说的了。”~

// 奇特拉对话
@250 = ~“作为一个施法者，在这里有什么需要注意的吗？”~
@251 = ~她仔细端详了你一会儿。“也许有。你看起来不像是那种通常被艺术赋予天赋的人。”~
@252 = ~“如果你的法术失效了，那你就需要找到一个法术之钥。它可以作为某种聚焦器。”~
@253 = ~“我在哪里能找到？”~
@254 = ~“我不知道。”她顿了顿，思索着。“你可以四处找找。诅咒城这里或地下的某处可能有一个。”~

// 交互区域
@500 = ~“石柱”~
@501 = ~石柱周围的地面看起来有些扰动，好像有人在‘不久之前’——也许是过去几年内——走过这里。更彻底的搜索发现柱子一侧有一个微小的开关。~
@502 = ~拨动开关。~
@503 = ~不碰开关。~
@504 = ~你伸手拨动开关。令你惊讶的是，一个伪装很好的盖板松开了，露出了一个隐藏的储藏处。~

// 物品与法术
@1000 = ~混沌海法术之钥~
@1001 = ~混沌海法术之钥
重量：0

这个混沌海的符号被刻在一块人皮上。它有金属的气味，但摸起来却很光滑，如同天鹅绒。只要你将其携带在身上，它就能防止你的法术在混沌海位面上失控。~
@1002 = ~外域法术之钥~
@1003 = ~外域法术之钥
重量：0

这个外域的符号被刻在一块人皮上。它有种寻常的气味，但摸起来像一块湿布。只要你将其携带在身上，它就能防止你的法术在外域的任何地方失控。~
@1004 = ~法术失败~
@1005 = ~移除法术失败~

// 日志条目
@1500 = ~我从福尔·叉舌那里得到了一把用于巴托地狱位面的法术之钥。据福尔说，需要法术之钥来防止我的法术在外层位面上失控。每个位面似乎都需要特定的钥匙。~
@1510 = ~垃圾场看守凯斯，在他从这个地方消失前，留给我一把‘法术之钥’。显然需要它来防止我的法术在卡瑟利位面上失控。~
@1520 = ~戴娜拉告诉我，悔恨要塞被隔绝了外部能量，这使得在那个地方无法施法。我或许能从过去的我留下的线索中发现更多信息。~
@1530 = ~获取卢比刚法术之钥。~
@1531 = ~模机工程师告诉我，门厅里的模机负责为前来尝试地城建筑的“冒险者”提供工具。他告诉了我关键词“观星者”，以此指示迷宫入口处的卢比刚向导交出一把法术之钥。在混沌海位面——卢比刚地城建筑群的建造地——需要这个物品来防止我的法术失控。~
@1532 = ~在说出正确的关键词后，门厅里的模机给了我用于混沌海位面的法术之钥。~
@1540 = ~骷髅柱向我揭示，我无法在位面中施法是因为我的不朽。我存在的核心，也就是我的凡人性，是施法所必需的。法术之钥可以作为聚焦器，只要我将其携带在身上。~
@1541 = ~骷髅柱向我揭示，我无法在位面中施法是因为我的不朽。我存在的核心，也就是我的凡人性，是施法所必需的。法术之钥可以作为聚焦器，只要我将其携带在身上。显然这个限制不适用于印记城，但柱子没有告诉我原因。~
@1550 = ~奇特拉告诉我，我可能需要一把‘法术之钥’，它作为某种聚焦器，来防止我的法术在诅咒城城内或地下失效。她无法告诉我在哪里能找到，所以我得自己留神了。~